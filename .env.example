# =============================================================================
# KAI PRAKRITI PRODUCTION ENVIRONMENT VARIABLES (1M+ CONCURRENT USERS)
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Multi-Core Scale (Set to 0 to auto-fork across all available CPU cores)
ENABLE_CLUSTER=true
MAX_WORKERS=0

# Security Secrets (64-character cryptographic token)
JWT_SECRET=b7d8f92a1c4e6b3f8a0e2d5c7b1a9f4e6d3c8a0b2e5f7a1c9e4b6d8f0a2c5e7b
ADMIN_EMAIL=kaiprakriti@gmail.com
ADMIN_PASSWORD_HASH=f77b789bead9b925b6a7ee7b2c5d80cecb7ff9b49ecb28292d3f44e1f740db38
AUTH_SALT=kai_prakriti_2026_salt

# Rate Limit Thresholds (DDoS & Brute Force Protection)
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_LEAD_MAX=10
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AI_MAX=25

# Cache Performance Tuning
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=2000

# Google Gemini AI Copilot API Key (Protected Server-Side Proxy)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=MY_APP_URL
