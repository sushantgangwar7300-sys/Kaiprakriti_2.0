rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.company is string && data.company.size() > 0 && data.company.size() <= 200;
    }

    match /leads/{leadId} {
      // Inquiries can be submitted by prospective clients from the public web form
      allow create: if isValidLead(request.resource.data);
      
      // Reading, updating status, adding notes, and deleting leads in admin dashboard
      allow read, update, delete: if true;
    }

    // Health/connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
