  app.get('/api/v1/leads', requireAdminAuth, (req, res) => {
    res.status(200).json({
      success: true,
      count: leadsStore.length,
      leads: leadsStore,
    });
  });

  app.patch('/api/v1/leads/:id', requireAdminAuth, (req, res): void => {
    const { id } = req.params;
    const { status, note } = req.body;

    const lead = leadsStore.find((l) => l.id === id);
    if (!lead) {
      res.status(404).json({ error: 'Not Found', message: 'Lead record not found.' });
      return;
    }

    if (status) lead.status = sanitizeString(status);
